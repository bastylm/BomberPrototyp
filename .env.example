# Variables for the isolated demonstration instance. Replace placeholders before deployment.
SECRET_KEY=generate-a-unique-secret-before-deploying
DEBUG=False
ALLOWED_HOSTS=demo.sigbomberosmulchen.cl
CSRF_TRUSTED_ORIGINS=https://demo.sigbomberosmulchen.cl

DB_ENGINE=mysql
DB_NAME=bomberprototyp_demo
DB_USER=bomberprototyp_app
DB_PASSWORD=set-a-unique-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Demo email stays in local logs unless a dedicated mailbox is configured.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
STATIC_ROOT=/var/www/bomberprototyp/static
MEDIA_ROOT=/var/www/bomberprototyp/media
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
